# cp backend/.env.example backend/.env
# BE 팀 변수를 넣는 자리. 값이 없어도 파일 자체는 있어야 한다.
# DB 접속·포트·프로필은 compose.yaml 이 주입한다. 같은 이름을 여기 써도 compose 가 이긴다.

# 영상 등록. 주석 처리된 값은 application.yml 기본값이며 필요할 때만 지정한다.
# 기본값 없는 필수 설정이 비어 있으면 등록을 거부한다.
# Compose 원본 경로는 NPICK_MEDIA_ROOT, 임시 경로는 CLIP_UPLOAD_ROOT로 주입된다.
# Compose 밖에서 실행할 때는 두 경로를 서로 다른 절대 경로로 지정한다.
# CLIP_MEDIA_ROOT=
# CLIP_UPLOAD_ROOT=

# 크기는 byte, 길이는 초. 허용 형식·코덱은 쉼표로 구분한다.
# CLIP_MAX_FILE_BYTES=10737418240
# 전체 HTTP 요청은 영상 한도 + 자막·대본·multipart 여유분을 포함한다.
# CLIP_MAX_REQUEST_BYTES=10738466816
# 자막 파서의 운영 크기 제한(byte). 전체 HTTP 요청 한도도 함께 고려한다.
# CLIP_SUBTITLE_MAX_BYTES=10485760
# CLIP_MAX_DURATION_SECONDS=3600
# CLIP_ALLOWED_CONTAINERS=mp4,mov
# CLIP_ALLOWED_VIDEO_CODECS=h264,hevc
# CLIP_ALLOWED_AUDIO_CODECS=aac,mp3

# 전체 영상 검사 시간을 포함한다. 단위는 s 또는 m 등을 명시한다.
# CLIP_PROBE_TIMEOUT=60s
# 개발용 잠정값이며 실제 영상·실행 환경 측정 후 조정한다.
# CLIP_DECODE_TIMEOUT=30m

# 기대 버전은 pipeline.yml의 stage_versions로 지정한다. 없으면 unknown으로 배정되지 않는다.
# 빌드에 포함한 infra/compose/profiles/pipeline.yml 대신 외부 파일을 사용할 때 지정한다.
# NPICK_PIPELINE_PROFILE=file:/absolute/path/pipeline.yml
# 현재 영상 분석은 자체 GPU 사용. 외부 AI 사용 시 true로 지정한다.
# CLIP_EXTERNAL_PROCESSING_REQUIRED=false
