# cp .env.example .env 후 값을 채운다. .env 는 커밋되지 않는다.
# 이 파일은 인프라 값만 담는다. FE 는 frontend/.env, BE 는 backend/.env 를 쓴다.
# 배포 환경에서 바꿀 값: POSTGRES_PASSWORD, NPICK_DOMAIN, BACKEND_PROFILE

# 비어 있으면 compose 가 기동을 거부한다
POSTGRES_PASSWORD=
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=npick
POSTGRES_USER=npick

# nginx server_name
NPICK_DOMAIN=localhost
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

BACKEND_PORT=8081
POSTGRES_PORT=5432
FRONTEND_PORT=3000
AI_WORKER_PORT=8000

BACKEND_PROFILE=local
AI_LOG_LEVEL=INFO
