# cp .env.example .env 후 값을 채운다. .env 는 커밋되지 않는다.
# 이 파일은 인프라 값만 담는다. FE 는 frontend/.env, BE 는 backend/.env 를 쓴다.
# 배포 환경에서 바꿀 값: POSTGRES_PASSWORD, NPICK_DOMAIN, BACKEND_PROFILE, COMPOSE_PROFILES

# 비어 있으면 compose 가 기동을 거부한다. openssl rand -hex 24
POSTGRES_PASSWORD=
# MLflow 전용 DB role 의 비밀번호. 접속 URI 에 그대로 들어가므로
# / + = 가 섞이는 base64 가 아니라 hex 로 만든다: openssl rand -hex 24
MLFLOW_DB_PASSWORD=
# ParadeDB = PostgreSQL 18 + pg_search + pgvector. 검색 설계의 전제다.
POSTGRES_IMAGE=paradedb/paradedb:0.25.6-pg18
POSTGRES_DB=npick
POSTGRES_USER=npick

# proxy 를 넣으면 nginx 가 뜬다. 인증서가 있는 환경에서만 쓴다
COMPOSE_PROFILES=

# 아래 셋은 nginx 가 뜰 때만 쓰인다
NPICK_DOMAIN=localhost
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# EC2 의 Jenkins 는 18080 을 쓴다. 8080 은 백엔드 몫이다.
BACKEND_PORT=8080
POSTGRES_PORT=5432
FRONTEND_PORT=3000
AI_WORKER_PORT=8000
MLFLOW_PORT=5000

# 이 값을 주면 MLflow 의 기본 허용 목록(localhost·사설 IP)을 통째로 대체한다.
# 컨테이너 이름과 loopback 은 반드시 남긴다. 빠지면 내부 호출이 Invalid Host header 로 막힌다.
# nginx 는 포트 없는 Host 를 넘기므로, 프록시를 쓰는 환경은 도메인을 그대로 추가한다.
MLFLOW_ALLOWED_HOSTS=mlflow,mlflow:5000,localhost,localhost:5000,127.0.0.1,127.0.0.1:5000

BACKEND_PROFILE=local
AI_LOG_LEVEL=INFO
