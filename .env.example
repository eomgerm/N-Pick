# cp .env.example .env 후 값을 채운다. .env 는 커밋되지 않는다.

# 이미지 태그 고정. latest 는 메이저 변경 시 볼륨 호환이 깨진다.
# 벡터를 PG 에 저장하게 되면 같은 메이저의 pgvector/pgvector:pg17 로 교체 가능.
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=npick
POSTGRES_USER=npick
# 필수. openssl rand -base64 24
POSTGRES_PASSWORD=

# 전부 127.0.0.1 에만 바인딩된다
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
AI_WORKER_PORT=8000

BACKEND_PROFILE=local
AI_LOG_LEVEL=INFO

# 빌드 시점 값. 바꾸면 docker compose build 필요
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api/v1
NEXT_PUBLIC_APP_MODE=demo
