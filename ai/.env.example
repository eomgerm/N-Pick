# cp ai/.env.example ai/.env
# AI 팀 변수를 넣는 자리. 값이 없어도 파일 자체는 있어야 한다.
# 호스트·포트·디바이스·로그 수준은 compose.yaml 이 주입한다. compose 가 이긴다.

# OCR 모델 가중치 캐시. 컨테이너에서는 Dockerfile 이 잡아 둔 경로를 쓴다.
# 비우면 rapidocr 기본값(site-packages 안)이라 컨테이너를 다시 만들 때마다 다시 받는다.
# NPICK_AI_OCR_MODEL_DIR=

# VLM 장면 metadata(3단계). 가중치 이름은 **기본값이 없다** — 후보 비교로 정할 값이라
# 코드가 고르면 근거 없는 동결이 된다(FRD §11). 비우면 이 단계는 capabilities 에서 빠지고
# BE 가 배정하지 않는다. 후보 비교는 ai/docs/vlm-metadata.md §2.
# NPICK_AI_VLM_MODEL=
# NPICK_AI_VLM_MODEL_REVISION=
# NPICK_AI_VLM_MODEL_DIR=

# 텍스트 임베딩 (9단계). 모델·리비전은 S15P21A501-175 가 확정했고 settings 기본값이다.
# 아래는 그 값을 **덮어쓸 때만** 쓴다 — 바꾸면 전체 재색인이다.
# NPICK_AI_EMBEDDING_MODEL=
# NPICK_AI_EMBEDDING_MODEL_REVISION=
# NPICK_AI_EMBEDDING_MODEL_DIR=
# NPICK_AI_EMBEDDING_BATCH_SIZE=

# 질의측 임베딩 (S15P21A501-164). 리졸버 배포 단위가 쓴다.
# 접두는 모델 카드가 정한다 — arctic-ko 는 질의에만 `query: ` 를 요구한다(문서측은 없음).
# 모델을 바꾸면 이 값도 함께 확인한다.
# NPICK_AI_EMBEDDING_QUERY_PREFIX=query:_(끝 공백 포함)
# 기동 시 가중치를 기다릴 상한(초). 넘기면 기동을 계속하고 로딩은 백그라운드에서 이어진다.
# 그 동안의 검색은 dense 채널 없이 BM25 로 돈다. 콜드 스타트가 startup probe 유예를
# 넘겨 재시작 루프가 되는 것을 막는 값이다.
# NPICK_AI_EMBEDDING_WARMUP_TIMEOUT_SECONDS=60

# 외부 VLM 은 기본 경로가 아니다(02-container.md 요소 표: 자체 GPU). 아래를 전부 채워도
# clip 별 외부 처리 권리 확인이 없으면 전송 전에 fail-closed 한다(PRD §12.4) — 그 확인은
# 설정으로 대신할 수 없다. 자세한 것은 vlm_metadata/external_policy.py.
# NPICK_AI_VLM_BACKEND=transformers
# NPICK_AI_VLM_EXTERNAL_ENABLED=false
# NPICK_AI_VLM_EXTERNAL_PROVIDER_PROFILE=
# NPICK_AI_VLM_EXTERNAL_ENDPOINT=
# NPICK_AI_VLM_EXTERNAL_MODEL=
# NPICK_AI_VLM_EXTERNAL_PROVIDER_TERMS_CONFIRMED=false
# NPICK_AI_VLM_EXTERNAL_MAX_PAYLOAD_BYTES=0
# NPICK_AI_VLM_EXTERNAL_API_KEY=

# ASR(자막·CC 미커버 구간 보완). 가중치 이름은 VLM 과 같은 이유로 **코드에 기본값이
# 없다** — 비우면 이 단계는 capabilities 에서 빠진다. 실측으로 정해진 값은
# `large-v3-turbo` 다(ai/docs/asr.md §5.6): 경계 시각을 맞히는 유일한 모델이고 medium
# 보다 빠르다. small 을 쓰려면 word_timestamps 를 켜야 한다(§5.3).
# compute type 을 비우면 장치 기본값(CUDA=float16, CPU=int8)이다. float16 계열은 CUDA
# 전용이라 아직 재지 못했다.
# NPICK_AI_ASR_MODEL=
# NPICK_AI_ASR_MODEL_REVISION=0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf
# NPICK_AI_ASR_COMPUTE_TYPE=
# NPICK_AI_ASR_MODEL_DIR=

# 잡 수신(파이프라인 워커). 켜면 BE 잡 API 를 long-poll 한다.
# 끄면 폴링하지 않는다 — 질의 리졸버로 쓰는 프로세스가 이 상태다.
# 계약: docs/contracts/job-api.md
# NPICK_AI_JOB_POLL_ENABLED=true
# NPICK_AI_JOB_API_BASE_URL=http://backend:8080
# NPICK_AI_JOB_API_TOKEN=
# NPICK_AI_JOB_FLEET=local
# 이 배포가 맡을 단계(쉼표 구분). 비우면 구현된 전부를 선언한다.
# 좁히기만 한다 — 목록에 있어도 모델 미지정·워밍업 실패인 단계는 빠진다.
# CPU 워커: scene_detection,frame_extraction,ocr,indexing
# GPU 파드: vlm_metadata,asr,text_embedding
# NPICK_AI_JOB_STAGES=

# Query Resolver LLM. 값은 각자 넣는다 — 이 파일은 커밋되므로 키를 적지 않는다.
# ollama | gms. 기본 ollama (FRD §13.4 가 외부 전송을 별도 승인 대상으로 둔다)
#
# **빈 값으로 두지 않는다.** Literal["ollama","gms"] 라 빈 문자열은 코드 기본값으로
# 떨어지지 않고 pydantic 검증에서 걸려 워커가 기동하지 못한다. 기본값을 쓰려면 이 줄을
# 주석 처리한다(settings.py 의 resolver_backend 가 "ollama").
# NPICK_AI_RESOLVER_BACKEND=ollama
NPICK_AI_OLLAMA_MODEL=
# backend=gms 일 때만 필요하다.
#
# 모델은 **gpt-4o-mini 로 확정**했다 (S15P21A501-102, 2026-09-15 실측).
# 개발셋 200문항 x 후보 6종에서 gpt-4.1 과 품질 차이가 검출되지 않았는데
# (slot_f1 차이 +0.0004, 95% CI [-0.056, +0.057]) 호출당 크레딧이 2.9 vs 42 다.
# 근거와 재검토 조건: eval/query_resolver/README.md, 공유 문서 허브의 ADR-001.
NPICK_AI_GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/chat/completions
NPICK_AI_GMS_API_KEY=
NPICK_AI_GMS_MODEL=gpt-4o-mini
