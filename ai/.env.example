# cp ai/.env.example ai/.env
# AI 팀 변수를 넣는 자리. 값이 없어도 파일 자체는 있어야 한다.
# 호스트·포트·디바이스·로그 수준은 compose.yaml 이 주입한다. compose 가 이긴다.

# 잡 수신(파이프라인 워커). 켜면 BE 잡 API 를 long-poll 한다.
# 끄면 폴링하지 않는다 — 질의 리졸버로 쓰는 프로세스가 이 상태다.
# 계약: docs/contracts/job-api.md
# NPICK_AI_JOB_POLL_ENABLED=true
# NPICK_AI_JOB_API_BASE_URL=http://backend:8080
# NPICK_AI_JOB_API_TOKEN=
# NPICK_AI_JOB_FLEET=local
