# nginx:alpine 이 /etc/nginx/templates/*.template 을 envsubst 로 처리한다.
# NGINX_ENVSUBST_FILTER=NPICK_ 로 범위를 좁혀 $host 같은 nginx 변수를 보호한다.

upstream npick_web {
    server frontend:3000;
}

upstream npick_api {
    server backend:8080;
}

server {
    # default_server 가 없으면 이미지 기본 default.conf 가 80번의 기본 서버가 되어
    # server_name 과 맞지 않는 요청(healthcheck 의 Host: 127.0.0.1)이 404 가 된다.
    listen 80 default_server;
    server_name ${NPICK_DOMAIN};

    # 상한은 Gate D 미동결. infra/compose/profiles/media.yml 이 정본이고 api 가 검증한다
    client_max_body_size 0;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # compose healthcheck 전용. 업스트림에 의존하지 않는다
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass http://npick_api;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    # api 의 X-Accel-Redirect 대상(FR-RES-013). api 구현 전이라 아직 쓰이지 않는다
    location /internal-media/ {
        internal;
        alias /srv/npick/media/;
    }

    location / {
        proxy_pass http://npick_web;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}
