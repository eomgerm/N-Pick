# nginx:alpine 이 /etc/nginx/templates/*.template 을 envsubst 로 처리한다.
# NGINX_ENVSUBST_FILTER=NPICK_ 로 범위를 좁혀 $host 같은 nginx 변수를 보호한다.
#
# TLS 를 쓰는 환경은 이 디렉터리 대신 templates-tls 를 마운트한다(NGINX_TEMPLATE_DIR).

include /etc/nginx/snippets/upstreams.conf;

server {
    # default_server 가 없으면 이미지 기본 default.conf 가 80번의 기본 서버가 되어
    # server_name 과 맞지 않는 요청(healthcheck 의 Host: 127.0.0.1)이 404 가 된다.
    listen 80 default_server;
    server_name ${NPICK_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # compose healthcheck 전용. 업스트림에 의존하지 않는다
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    include /etc/nginx/snippets/app-routes.conf;
}
