// N-Pick 운영 잡 — 시연 준비와 RunPod 파드 전원 (S15P21A501-187).
// 등록 절차와 credential 은 infra/jenkins/README.md.
//
// 배포 파이프라인(Jenkinsfile)과 섞지 않는다. 이쪽은 사람이 눌러서 도는 잡이고
// 실패해도 배포를 막지 않아야 한다.
//
// **SSAFY GPU 서버로는 나가지 않는다.** drain 은 사람이 SSH 로 돌린다
// (docs/architecture/03-deployment.md 의 "상주 서버를 올릴 수 없다"와 충돌하므로
// Jenkins 에이전트를 붙이는 안은 팀 합의 전까지 보류).

// transcript_selection 워커 구현이 들어오면 이 값을 false 로 바꾸고,
// pipeline.yml 에 그 단계의 stage_versions 를 채운다. 그때 WAIT 가 열린다.
SEED_WAIT_BLOCKED = true

pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '30'))
    disableConcurrentBuilds()
  }

  parameters {
    // **RUNPOD_DOWN 이 첫 항목이어야 한다.** declarative 의 choice 기본값은 첫 항목이고
    // cron 빌드는 파라미터 기본값으로 돈다. 순서를 바꾸면 새벽 4시에 파드가 켜진다.
    choice(
      name: 'ACTION',
      choices: ['RUNPOD_DOWN', 'RUNPOD_UP', 'SEED'],
      description: 'RUNPOD_DOWN: 파드 정지(cron 기본) / RUNPOD_UP: 파드 재개 / SEED: 시드 영상 등록'
    )
    string(
      name: 'VIDEO_DIR',
      defaultValue: '',
      description: 'SEED 에서만 쓴다. **Jenkins 컨테이너 안에서 보이는 경로**여야 한다 — 마운트는 /var/jenkins_home 과 NPICK_DEPLOY_DIR 뿐이고, 그 밖의 호스트 경로는 빈 폴더로 보인다. 영상 옆 같은 이름 .json 사이드카가 있어야 한다'
    )
    string(
      name: 'WAIT_SECONDS',
      defaultValue: '0',
      description: 'SEED 에서만 쓴다. **현재는 0 만 쓸 수 있다** — transcript_selection 워커 구현이 없어 run 이 완주하지 못하므로 0 보다 큰 값은 거부한다. 구현되면 Jenkinsfile.ops 의 SEED_WAIT_BLOCKED 를 지운다'
    )
  }

  triggers {
    // 끄는 걸 잊어도 새벽에 내려간다. 이미 꺼져 있으면 runpod.sh 가 0 으로 끝나 no-op 이다.
    // 파드는 시간당 과금이고 하루를 깜빡하면 하루치가 그대로 나간다.
    //
    // **TZ 를 cron 문자열 안에 적는다.** 아래 environment 의 TZ 는 빌드 실행 환경에만
    // 걸리고 트리거 시각은 Jenkins controller 의 시간대를 따른다. controller 가 UTC 면
    // 한국 시간 오후 1시에 파드가 내려간다 - 시연 도중일 수 있는 시각이다.
    cron('''TZ=Asia/Seoul
0 4 * * *''')
  }

  environment {
    TZ = 'Asia/Seoul'
    DEPLOY_DIR = "${env.NPICK_DEPLOY_DIR ?: '/deploy'}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        echo "ACTION=${params.ACTION}"
      }
    }

    stage('RunPod') {
      when { expression { params.ACTION in ['RUNPOD_DOWN', 'RUNPOD_UP'] } }
      steps {
        // **파드 ID 를 credential 에 두지 않는다.** 재고가 없어 파드를 다시 만들면 ID 가
        // 바뀌는데(runpod-create.sh), 그때마다 사람이 웹 UI 로 고쳐야 하고 잊으면
        // 없는 파드를 끄고 성공했다고 보고한다. runpod.sh 가 이름으로 찾는다.
        withCredentials([
          string(credentialsId: 'runpod-api-key', variable: 'RUNPOD_API_KEY')
        ]) {
          sh "infra/jenkins/runpod.sh ${params.ACTION == 'RUNPOD_UP' ? 'resume' : 'stop'}"
        }
      }
    }

    stage('Seed') {
      when { expression { params.ACTION == 'SEED' } }
      steps {
        script {
          if (!params.VIDEO_DIR?.trim()) {
            error('SEED 에는 VIDEO_DIR 이 필요하다')
          }
          // **완주할 수 없는 대기를 걸지 않는다.** pipeline.yml 의
          // stage_versions 에 transcript_selection 이 없고 워커에도 구현이
          // 없어서, run 이 그 단계에서 멈추고 대기는 제한 시간까지 돈다.
          // 숨기지 않고 여기서 거부한다 — 숨기면 되살리는 것을 잊는다.
          if ((params.WAIT_SECONDS ?: '0').trim() != '0' && SEED_WAIT_BLOCKED) {
            error('WAIT_SECONDS 는 아직 0 만 쓸 수 있다. '
                + 'transcript_selection 이 구현되고 pipeline.yml 에 '
                + 'stage_versions 가 채워진 뒤에 이 가드를 지운다 (S15P21A501-187).')
          }
        }
        withCredentials([usernamePassword(
          credentialsId: 'npick-reviewer',
          usernameVariable: 'NPICK_LOGIN_ID',
          passwordVariable: 'NPICK_PASSWORD'
        )]) {
          // 컨테이너 네트워크로 직접 간다. nginx·TLS 를 거칠 이유가 없다.
          withEnv([
            'NPICK_API_BASE=http://backend:8080/api/v1',
            "NPICK_SEED_WAIT_SECONDS=${params.WAIT_SECONDS}",
            "SEED_DIR=${params.VIDEO_DIR}"
          ]) {
            sh 'scripts/seed-clips.sh "$SEED_DIR"'
          }
        }
      }
    }
  }

  post {
    failure {
      echo "실패했다. ACTION=${params.ACTION}"
    }
  }
}
